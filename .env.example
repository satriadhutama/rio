# Salin file ini menjadi ".env" lalu isi nilainya.
# File .env TIDAK ikut tersimpan ke GitHub (sudah dicegah lewat .gitignore).

# Kunci API CoinGecko Anda (dapat dari https://www.coingecko.com/en/developers/dashboard)
COINGECKO_API_KEY=

# Isi "pro" hanya kalau Anda berlangganan paket berbayar CoinGecko. Kalau
# pakai kunci gratis (Demo), biarkan "demo".
COINGECKO_PLAN=demo
